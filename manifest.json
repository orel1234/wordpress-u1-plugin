{
  "manifest_version": 3,
  "name": "U1 Helper",
  "version": "1.0.0",
  "description": "Accessibility implementation helper for User1st (u1) library",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "U1 Helper"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
