{
  "name": "u1-studio",
  "version": "3.1.0",
  "private": true,
  "description": "U1 Studio — Chrome side-panel accessibility implementation tool for the User1st (u1) library.",
  "type": "module",
  "scripts": {
    "check:version": "node scripts/build.mjs --check-only",
    "verify": "node scripts/verify-all.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "build": "npm run verify && node scripts/build.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1"
  }
}
