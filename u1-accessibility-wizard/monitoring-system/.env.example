# Copy this file to .env and fill in before running `npm start`.

# Port the dashboard listens on.
PORT=3300

# Cron expression for the daily check (default: every day at 06:00 server time).
CHECK_CRON=0 6 * * *

# SMTP credentials for failure-report emails. If left unset, reports are
# written to monitoring-system/data/reports/ instead of being emailed, and
# the dashboard keeps working normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Optional. Absolute path to a pre-installed Chromium, for hosts where
# Playwright's own browser download is disabled. Leave unset to let Playwright
# manage its own browser.
PLAYWRIGHT_CHROMIUM_PATH=
